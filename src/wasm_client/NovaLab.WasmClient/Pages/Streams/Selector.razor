@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using NovaLab.ApiClient.Models
@using NovaLab.WasmClient.Services
@using Ulid=NovaLab.ApiClient.Models.Ulid
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/streams/selector"
@layout MainLayout

@inject NovaLabUserService NovaLabUserService
@inject NovaLabApiService NovaLabApiService
@inject IDialogService DialogService
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<div class="h-full w-full p-6">
    <MudGrid>
        @if (Data is not null) {
            @foreach (TrackedStreamSubjectDto item in Data) {
                <MudItem sm="12" md="6" xl="4">
                    <MudPaper Class="flex flex-row gap-2 rounded-xl p-3 lg:gap-4">
                        @* Image Section *@
                        <div class="h-full w-2/5 flex-shrink-0 relative">
                            <MudImage Src="@(item.TwitchGameImageUrl?.Replace("{width}x{height}", "200x300"))" 
                                      Alt="@item.TwitchGameName" 
                                      Class="rounded-lg aspect-poster h-auto w-full shadow-inner"/>
                        </div>

                        @* Data Section *@
                        <div class="flex flex-col flex-grow">
                            <MudText Typo="Typo.h6" Class="flex-wrap text-wrap">@item.TwitchTitle</MudText>
                            
                            <MudStack Row="true" Class="flex-wrap gap-1 mt-4">
                                @foreach (string tag in item.TwitchTags) {
                                    <MudChip T="string" Class="m-0 leading-0.5 !h-4 !px-2 transition-[color,background] ease-in-out duration-1000 rounded-full bg-slate-600 text-slate-300 hover:text-slate-50 hover:bg-slate-400">
                                        <span class="text-xs">@tag</span>
                                    </MudChip>
                                }
                            </MudStack>

                            <MudToolBar Class="mt-auto pl-0">
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                               OnClick="() => OnEditAsync(item.Id)"/>
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error"
                                               OnClick="() => OnDeleteAsync(item.Id)"/>
                                <MudSpacer/>
                                <MudButton OnClick="() => OnSubmitAsync(item.Id)">Apply</MudButton>
                            </MudToolBar>
                        </div>
                    </MudPaper>
                </MudItem>
            }
        }
    </MudGrid>
</div>

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@
@code {
     private List<TrackedStreamSubjectDto>? Data { get; set; }
    
     // -----------------------------------------------------------------------------------------------------------------
     // Methods
     // -----------------------------------------------------------------------------------------------------------------
     protected override async Task OnInitializedAsync() {
         await FetchDataAsync();
     }

     private async Task FetchDataAsync() {
         Guid? userId = await NovaLabUserService.GetUserIdAsync();
         if (userId is null) return;
         
         // TrackedStreamSubjectDtoIApiResult result = await NovaLabApiService.TrackedStreamSubject.GetTrackedStreamSubjectsAsync(userId:userId);
         // Data = result.Data;
         
         StateHasChanged();
     }
     
     private async Task OnSubmitAsync(Ulid itemId) {
         if (await NovaLabUserService.GetUserIdAsync() is not {} userId) return;
         
         // await NovaLabApiService.TrackedStreamSubject.SelectTrackedStreamSubjectAsync(
         //     userId,
         //     itemId
         // );
     }
     
     private async Task OnEditAsync(Ulid itemId) {
         TrackedStreamSubjectDto? dto = Data?.First(d => d.Id == itemId);
         if (dto is null) return;
         
         var parameters = new DialogParameters<EditorDialog> { { x => x.StreamSubject, dto} };
         var options = new DialogOptions {FullWidth = true};
         
         IDialogReference dialog = await DialogService.ShowAsync<EditorDialog>("Edit Stream Info", parameters, options);
         DialogResult? result = await dialog.Result;
         
         if (result is { Canceled: false }) await FetchDataAsync();
     }

     private async Task OnDeleteAsync(Ulid itemId) {
         bool? result = await DialogService.ShowMessageBox("Delete Stream Setup", "Deletion can only be undone by an admin", yesText: "Delete", cancelText: "Cancel");
         if (result is true) {
            //  await NovaLabApiService.TrackedStreamSubject.DeleteTrackedStreamSubjectAsync(
            //     itemId
            // );
             await FetchDataAsync();
         }
     }
}
