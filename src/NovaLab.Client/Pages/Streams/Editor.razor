@* ------------------------------------------------------------------------------------------------------------------ *@
@* Imports
@* ------------------------------------------------------------------------------------------------------------------ *@
@using NovaLab.ApiClient.Models
@using NovaLab.Services
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Descriptors
@* ------------------------------------------------------------------------------------------------------------------ *@
@page "/streams/editor"
@layout MainLayout
@inject ILogger Logger
@inject NovaLabUserService NovaLabUserService
@inject NovaLabApiService NovaLabApiService

@* ------------------------------------------------------------------------------------------------------------------ *@
@* Html
@* ------------------------------------------------------------------------------------------------------------------ *@
<MudPaper>
    <EditorComponent OnSubmit="@OnSubmit" StreamSubject="@StreamSubject"/>
</MudPaper>
@* ------------------------------------------------------------------------------------------------------------------ *@
@* Code
@* ------------------------------------------------------------------------------------------------------------------ *@
@code {
    public TrackedStreamSubjectDto StreamSubject { get; set; } = new() {
        TwitchTitle = string.Empty,
        TwitchBroadcastLanguage = "en",
        TwitchTags = [],
        TwitchGameName = string.Empty
    };
    
    private async Task OnSubmit(StreamEditorForm form) {
        Guid? userId = await NovaLabUserService.GetUserIdAsync();
        if (userId is null) return;

        await NovaLabApiService.TrackedStreamSubject..UpsertTrackedStreamSubjectAsync(
            null,
            new TrackedStreamSubjectDtoPost {
                NovaLabUserId=(Guid)userId,
                TwitchTitle=form.TwitchTitle,
                TwitchBroadcastLanguage=form.TwitchBroadcastLanguage ?? "en",
                TwitchTags=form.TwitchTags?.Split(";").ToList() ?? [],
                TwitchGameTitleName =form.TwitchGameTitleName
            }
        );

        StreamSubject = new TrackedStreamSubjectDto();
        StateHasChanged();
    }
}